{
  "name": "gemma-agent",
  "displayName": "Gemma Agent",
  "description": "Local AI coding assistant powered by Ollama + Gemma — chat, inline edit, code actions and agentic file editing, 100% offline.",
  "version": "0.1.0",
  "publisher": "ardacelep",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ardacelep/gemma-agent"
  },
  "keywords": [
    "ai",
    "llm",
    "ollama",
    "gemma",
    "copilot",
    "chat",
    "code completion",
    "local",
    "offline"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemmaAgent",
          "title": "Gemma Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gemmaAgent": [
        {
          "id": "gemmaAgent.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gemmaAgent.openChat",
        "title": "Gemma: Open Chat",
        "icon": "media/icon.svg"
      },
      {
        "command": "gemmaAgent.installServer",
        "title": "Gemma: Install Local AI Server"
      },
      {
        "command": "gemmaAgent.explainCode",
        "title": "Gemma: Explain Selected Code"
      },
      {
        "command": "gemmaAgent.refactorCode",
        "title": "Gemma: Refactor Selected Code"
      },
      {
        "command": "gemmaAgent.fixCode",
        "title": "Gemma: Fix Selected Code"
      },
      {
        "command": "gemmaAgent.generateTests",
        "title": "Gemma: Generate Tests for Selection"
      },
      {
        "command": "gemmaAgent.runInTerminal",
        "title": "Gemma: Run / Explain in Terminal"
      },
      {
        "command": "gemmaAgent.toggleCompletion",
        "title": "Gemma: Toggle Inline Completion"
      },
      {
        "command": "gemmaAgent.startOllama",
        "title": "Gemma: Start Ollama"
      },
      {
        "command": "gemmaAgent.pullModel",
        "title": "Gemma: Pull Model (ollama pull)"
      },
      {
        "command": "gemmaAgent.inlineEdit",
        "title": "Gemma: Inline Edit"
      },
      {
        "command": "gemmaAgent.generateCommitMessage",
        "title": "Gemma: Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gemmaAgent.openChat",
          "group": "navigation",
          "icon": "media/icon.svg"
        }
      ],
      "scm/title": [
        {
          "command": "gemmaAgent.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/context": [
        {
          "command": "gemmaAgent.explainCode",
          "when": "editorHasSelection",
          "group": "gemmaAgent@1"
        },
        {
          "command": "gemmaAgent.refactorCode",
          "when": "editorHasSelection",
          "group": "gemmaAgent@2"
        },
        {
          "command": "gemmaAgent.fixCode",
          "when": "editorHasSelection",
          "group": "gemmaAgent@3"
        },
        {
          "command": "gemmaAgent.generateTests",
          "when": "editorHasSelection",
          "group": "gemmaAgent@4"
        },
        {
          "command": "gemmaAgent.inlineEdit",
          "when": "editorHasSelection",
          "group": "gemmaAgent@5"
        }
      ]
    },
    "configuration": {
      "title": "Gemma Agent",
      "properties": {
        "gemmaAgent.apiProtocol": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Ollama native API (model download, warm-up, lifecycle management)",
            "OpenAI-compatible API (LM Studio, Jan, llama.cpp llama-server, vLLM, LocalAI)"
          ],
          "description": "Which local AI server protocol to use"
        },
        "gemmaAgent.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Server URL — Ollama or any OpenAI-compatible local server (LM Studio :1234, Jan :1337, llama-server :8080)"
        },
        "gemmaAgent.completionModel": {
          "type": "string",
          "default": "",
          "description": "Model to use for inline completion (empty = use the main model). A small/fast model here keeps ghost-text snappy."
        },
        "gemmaAgent.model": {
          "type": "string",
          "default": "gemma4:e4b",
          "enum": [
            "gemma4:e4b",
            "gemma4:e2b",
            "gemma4:9b",
            "gemma4:12b",
            "gemma4:27b",
            "gemma3:1b",
            "gemma3:4b",
            "gemma3:12b",
            "gemma3:27b",
            "gemma3n:e2b",
            "gemma3n:e4b"
          ],
          "description": "Gemma4 model to use"
        },
        "gemmaAgent.completionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completion"
        },
        "gemmaAgent.completionDebounceMs": {
          "type": "number",
          "default": 600,
          "description": "Debounce delay (ms) before triggering inline completion"
        },
        "gemmaAgent.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Max tokens for chat responses"
        },
        "gemmaAgent.numCtx": {
          "type": "number",
          "default": 8192,
          "minimum": 2048,
          "maximum": 131072,
          "description": "Context window size (num_ctx) sent to Ollama. Larger values use more RAM."
        },
        "gemmaAgent.codeActionsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Gemma code actions (lightbulb menu)"
        },
        "gemmaAgent.ollamaOnExit": {
          "type": "string",
          "default": "keep",
          "enum": [
            "ask",
            "keep",
            "stop"
          ],
          "enumDescriptions": [
            "Ask when VS Code closes (only if we started Ollama)",
            "Keep Ollama running in the background",
            "Stop Ollama when VS Code closes (only if we started Ollama)"
          ],
          "description": "What to do with Ollama when VS Code closes"
        },
        "gemmaAgent.agentMaxIterations": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum number of tool-call iterations the agent will perform before stopping"
        },
        "gemmaAgent.agentRequireApproval": {
          "type": "string",
          "default": "commands",
          "enum": [
            "commands",
            "commandsAndWrites",
            "never"
          ],
          "enumDescriptions": [
            "Ask before the agent runs shell commands",
            "Ask before shell commands AND file create/edit operations",
            "Never ask — the agent runs all tools automatically"
          ],
          "description": "Which agent tools require your approval before they run"
        },
        "gemmaAgent.completionMaxTokens": {
          "type": "number",
          "default": 150,
          "minimum": 32,
          "maximum": 512,
          "description": "Maximum tokens generated for inline code completions"
        },
        "gemmaAgent.completionLanguages": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {
            "*": true,
            "markdown": false,
            "plaintext": false,
            "scminput": false
          },
          "description": "Enable/disable inline completion per language id. \"*\" is the default for unlisted languages."
        },
        "gemmaAgent.completionAlternatives": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 3,
          "description": "Number of completion suggestions to generate (cycle with Alt+] / Alt+[). Values above 1 multiply completion latency with a local model."
        }
      }
    },
    "keybindings": [
      {
        "command": "gemmaAgent.openChat",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "gemmaAgent.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "gemmaAgent.inlineEdit",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      },
      {
        "command": "gemmaAgent.inlineEditAccept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gemmaAgent.inlineEditActive && editorTextFocus"
      },
      {
        "command": "gemmaAgent.inlineEditReject",
        "key": "escape",
        "when": "gemmaAgent.inlineEditActive && editorTextFocus"
      },
      {
        "command": "editor.action.inlineSuggest.acceptNextWord",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "inlineSuggestionVisible && textInputFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node esbuild.js",
    "bundle:watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
